{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch yt-dlp helper",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}\\yt-dlp-helper\\yt-dlp-helper.ps1",
      "cwd": "${workspaceFolder}\\yt-dlp-helper",
      "createTemporaryIntegratedConsole": true
    },
    {
      "name": "Launch yt-research GUI",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}\\yt-research-gui\\yt-research-gui.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true
    },
    {
      "name": "Debug whatsapp_transcribe.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/whatsapp_transcribe.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug music_transcribe",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/music_transcribe/music_transcribe.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/tools/music_transcribe"
    }
  ]
}
