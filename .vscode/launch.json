{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch yt-dlp helper",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}\\yt-dlp-helper\\yt-dlp-helper.ps1",
      "cwd": "${workspaceFolder}\\yt-dlp-helper",
      "createTemporaryIntegratedConsole": true
    },
    {
      "name": "Launch yt-research GUI",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}\\yt-research-gui\\yt-research-gui.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true
    },
    {
      "name": "Launch Transcript Studio",
      "type": "debugpy",
      "request": "launch",
      "module": "transcript_studio.cli",
      "cwd": "${workspaceFolder}/tools/transcript_studio",
      "python": "${workspaceFolder}/tools/transcript_studio/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/tools/transcript_studio/src"
      }
    },
    {
      "name": "Launch Transcript Studio (session file)",
      "type": "debugpy",
      "request": "launch",
      "module": "transcript_studio.cli",
      "cwd": "${workspaceFolder}/tools/transcript_studio",
      "python": "${workspaceFolder}/tools/transcript_studio/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--session",
        "${input:transcriptStudioSessionPath}"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/tools/transcript_studio/src"
      }
    },
    {
      "name": "Debug whatsapp_transcribe.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/whatsapp_transcribe.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug music_transcribe",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/music_transcribe/music_transcribe.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/tools/music_transcribe"
    }
  ],
  "inputs": [
    {
      "id": "transcriptStudioSessionPath",
      "type": "promptString",
      "description": "Path to a Transcript Studio session JSON file",
      "default": "${workspaceFolder}\\yt-research-gui\\data\\transcript-studio\\"
    }
  ]
}
